#include "crtgeoalg_sbnd.fcl"
#include "pmttriggerproducer.fcl"
#include "sbnd_flashfinder_deco.fcl"

BEGIN_PROLOG

MichelTaggerProducer:
{
  # Constants. These shouldn't need to be changed
  module_type: "MichelTaggerProducer"
  Pair1: @local::pmtTriggerProducer.Pair1
  Pair2: @local::pmtTriggerProducer.Pair2
  Unpaired: @local::pmtTriggerProducer.Unpaired
  PDs: ["pmt_coated", "pmt_uncoated"] #  "xarapuca_vuv", "xarapuca_vis"]
  DaphneFreq: 12.5	# ns per bin
  CAENFreq:   2.	# ns per bin
  PMTReadoutDelay: @local::SBNDDecoSimpleFlashTPC1.ReadoutDelay               # [us] Subtracts this from any PMT  waveform
  XARAPUCAReadoutDelay: @local::SBNDDecoSimpleFlashTPC1Arapuca.ReadoutDelay   # [us] Subtracts this from any XARAPUCA timestamp

  # Find candidate muon and michel flashes (summed waveform)
  OpFlashLabels: []
  FinderInputLabel: "opdecopmt"
  FinderInstanceName: ""
  FinderOpTypes: ["pmt_coated", "pmt_uncoated"]
  PMTTriggerLabel: "pmttriggerproducer"
  MinPMTMultiplicity: 10
  FinderPolarity: 1.  # -1 or 1. -1 flips the waveform.
  FindMuonThreshold: 1000.  # Min ADC for candidate muon peak
  FindMichelPeak: 100.      # Min Michel peak height as fraction of muon peak
  MuonMichelMaxRatio: 0.01
  CRTLabel: "crtsim"
  CRTStripHitLabel: "crtstrips"
  CRTGeoParams: @local::crtgeoalg_sbnd
  CRTOffset: 1700000.
  CRTClockSpeed: 1.
  CRTCoincidence: 300.
  RunningSumSampleWidth: 10

  ProduceWaveforms: false
  InputLabel: "opdecopmt" # opdecoxarapuca
  InstanceName: ""
  InputOpTypes: ["pmt_coated", "pmt_uncoated", "xarapuca_vuv", "xarapuca_vis"]
  InputPolarity: [1., 1., 1., 1.]
  MuonThresholds: [125., 75., 50., 50.]
  MichelThresholds: [ 125., 75., 50., 50.]  # Min ADC for a Michel peak for each detector type
  PeakCoincWindow: 80. # [ns] Search window relative to each candidate muon/michel peak
  TimeBinWidth: 100.        # Width of bins [ns]
  StartTimeAfterMuon: 400.  # Time to start analysis after muon peak (ns)
  EndTimeAfterMuon: 2000.    # Time to end analysis after muon peak (ns)
  
  # MC Info
  UseMC: true
  MCTruthLabel: "largeant"
  SEDLabel: "ionandscint"
  SEDOutLabel: "ionandscintout"
  OnlyStopping: false  // Only use muons that stop in the TPC
  AuxDetHitLabel: "largeant"
  AuxDetHitTags: ["LArG4DetectorServicevolAuxDetSensitiveCRTStripX", "LArG4DetectorServicevolAuxDetSensitiveCRTStripY"]

  # Misc - change these, I dare you
  RequireMichel: true        // requires Michel and Muon hit in same waveform to sav
  MinLifetime: 10. # ns Min mu lifetime, appllies to peak pairing and MC
  MaxLifetime: 10000.
  SaveHists: false
  MakeTree: true
  SaveEvents: [1]
  BinWaveforms: false
  Verbose: false
}

MichelTaggerProducerDecoData: @local::MichelTaggerProducer
MichelTaggerProducerDecoData.CRTLabel: "crtdecoder"
MichelTaggerProducerDecoData.UseMC: false
MichelTaggerProducerDecoData.CRTOffset: 367000

MichelTaggerProducerRawData: @local::MichelTaggerProducerDecoData
MichelTaggerProducerRawData.FinderInputLabel: "pmtdecoder"
MichelTaggerProducerRawData.FinderInstanceName: "PMTChannels"
MichelTaggerProducerRawData.InputLabel: "pmtdecoder"
MichelTaggerProducerRawData.InstanceName: "PMTChannels"
MichelTaggerProducerRawData.CRTOffset: 367000

END_PROLOG